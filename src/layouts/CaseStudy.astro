---
import Base from './Base.astro';
import Img from '../components/Img.astro';
import '../styles/case.css';

interface Props {
  title: string;
  tags: string[];
  meta: [string, string][];
  cover: { src: string; alt: string; caption?: string };
  pageTitle: string;
  description: string;
  prototype?: {
    src: string;
    poster: string;
    posterAlt: string;
    summary: string;
    steps: string[];
    note: string;
  };
}

const { title, tags, meta, cover, pageTitle, description, prototype } = Astro.props;
---

<Base title={pageTitle} description={description}>
  <article>
    <header class="case-hero wrap">
      <a class="case-back" href="/#design">All design work</a>
      <h1>{title}</h1>
      <p class="case-tags">{tags.join(', ')}</p>
      <dl class="case-meta">
        {meta.map(([label, value]) => (
          <div>
            <dt>{label}</dt>
            <dd>{value}</dd>
          </div>
        ))}
      </dl>
    </header>

    <figure class="case-cover wrap">
      <Img
        src={cover.src}
        alt={cover.alt}
        loading="eager"
        sizes="(min-width: 1200px) 1120px, 100vw"
        widths={[640, 1120, 1800]}
      />
      {cover.caption && <figcaption>{cover.caption}</figcaption>}
    </figure>

    {prototype && (
      <section class="proto wrap" aria-labelledby="proto-title">
        <div class="proto-text">
          <h2 id="proto-title">Try the prototype</h2>
          <p>{prototype.summary}</p>
          <ol>
            {prototype.steps.map((step) => <li>{step}</li>)}
          </ol>
          <p class="proto-note">{prototype.note}</p>
          <p><a href={prototype.src}>Open full screen</a></p>
        </div>
        <div class="proto-stage">
          <button class="proto-poster" type="button" data-proto={prototype.src} aria-label="Load the interactive prototype">
            <img src={prototype.poster} width="393" height="852" alt={prototype.posterAlt} />
            <span class="proto-go">Start the prototype</span>
          </button>
        </div>
      </section>
    )}

    <slot />
  </article>

  <script>
    // The prototype loads only when someone asks for it, so the page stays light.
    document.querySelectorAll<HTMLButtonElement>('.proto-poster').forEach((btn) => {
      btn.addEventListener('click', () => {
        const frame = document.createElement('iframe');
        frame.src = btn.dataset.proto!;
        frame.title = 'Interactive prototype';
        frame.className = 'proto-frame';
        frame.allow = 'clipboard-write';
        btn.replaceWith(frame);
        frame.focus();
      });
    });
  </script>
</Base>
