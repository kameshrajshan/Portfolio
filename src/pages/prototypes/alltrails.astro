<script>
  // ---------------------------------------------------------------- data
  type Activity = 'Hiking' | 'Biking';
  type Privacy = 'Public' | 'Private';

  interface HostEvent {
    id: string;
    trail: string;
    host: string;
    park: string;
    img: string;
    date: Date;
    minutes: number;
    activity: Activity;
    joined: number;
    cap: number;
    mine: boolean;
    privacy?: Privacy;
  }

  const IMG = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/prototypes/alltrails/img/`;
  const TRAILS: Record<string, { name: string; img: string }> = {
    'jug-island': { name: 'Jug Island Beach Trail', img: `${IMG}jug-island.webp` },
    'port-moody': { name: 'Port Moody Shoreline', img: `${IMG}host-forest-1.webp` },
    'grouse-grind': { name: 'Grouse Grind Trail', img: `${IMG}host-forest-2.webp` },
  };

  const MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];

  // Dates are relative to today so the prototype never shows a date in the past.
  const base = new Date();
  base.setHours(0, 0, 0, 0);
  base.setDate(base.getDate() + (((6 - base.getDay() + 7) % 7) || 7));
  const addDays = (n: number) => {
    const d = new Date(base);
    d.setDate(d.getDate() + n);
    return d;
  };
  const dateShort = (d: Date) => `${MONTHS[d.getMonth()]} ${d.getDate()}`;
  const dateLong = (d: Date) => `${dateShort(d)}, ${d.getFullYear()}`;
  const pad = (n: number) => String(n).padStart(2, '0');
  const time24 = (m: number) => `${pad(Math.floor(m / 60))}:${pad(m % 60)}`;
  const time12 = (m: number) => `${Math.floor(m / 60)}:${pad(m % 60)}`;
  const timeAmPm = (m: number) => `${Math.floor(m / 60) % 12 || 12}:${pad(m % 60)} ${m < 720 ? 'A.M' : 'P.M'}`;

  const seed = (): HostEvent[] => [
    { id: 'e-port-moody', trail: 'Port Moody Shoreline Trail', host: 'Shauna McQuinn', park: 'Inlet Park', img: `${IMG}port-moody.webp`, date: addDays(7), minutes: 18 * 60, activity: 'Biking', joined: 5, cap: 10, mine: false },
    { id: 'e-jug-island', trail: 'Jug Island Beach Trail', host: 'Rachael McClean', park: 'Belcarra Regional Park', img: `${IMG}jug-island.webp`, date: base, minutes: 9 * 60, activity: 'Hiking', joined: 3, cap: 10, mine: false },
  ];

  // ---------------------------------------------------------------- state
  const phone = document.getElementById('phone') as HTMLElement;
  const sheet = document.getElementById('sheet') as HTMLElement;

  interface Draft {
    trailId: string;
    date: Date;
    minutes: number;
    activity: Activity;
    size: number;
    privacy: Privacy;
  }

  let events: HostEvent[] = seed();
  let joinedIds = new Set<string>();
  let draft: Draft = newDraft('jug-island');
  let openerEl: HTMLElement | null = null;
  let toastTimer = 0;

  function newDraft(trailId: string): Draft {
    return { trailId, date: base, minutes: 9 * 60, activity: 'Hiking', size: 10, privacy: 'Public' };
  }

  const $ = <T extends HTMLElement>(sel: string, root: ParentNode = document) => root.querySelector(sel) as T;
  const $$ = <T extends HTMLElement>(sel: string, root: ParentNode = document) => [...root.querySelectorAll(sel)] as T[];

  // ---------------------------------------------------------------- helpers
  function toast(text: string) {
    const el = $('#toast');
    el.textContent = text;
    el.classList.add('is-on');
    clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => el.classList.remove('is-on'), 2200);
  }

  function showScreen(id: 'community' | 'events' | 'saved') {
    phone.dataset.screen = id;
    $$('.screen').forEach((s) => (s.hidden = s.dataset.screenId !== id));
    $('#topnav').hidden = id === 'saved';
    $('#back').hidden = id !== 'events';
    $$('.nav-item[data-nav]').forEach((n) => n.classList.toggle('is-active', n.dataset.nav === (id === 'saved' ? 'saved' : 'community')));
    $$('.nav-item:not([data-nav])').forEach((n) => n.classList.remove('is-active'));
    if (id === 'saved') renderSaved();
    if (id === 'events') renderJoin();
  }

  function showPane(pane: 'host' | 'join') {
    phone.dataset.pane = pane;
    $$('[data-pane-tab]').forEach((t) => {
      const on = t.dataset.paneTab === pane;
      t.classList.toggle('is-active', on);
      t.setAttribute('aria-selected', String(on));
    });
    ($('#pane-host') as HTMLElement).hidden = pane !== 'host';
    ($('#pane-join') as HTMLElement).hidden = pane !== 'join';
    if (pane === 'join') renderJoin();
  }

  // ---------------------------------------------------------------- join + saved lists
  function renderJoin() {
    const list = $('#join-list');
    list.innerHTML = events
      .filter((e) => e.mine ? e.privacy === 'Public' : true)
      .map((e) => {
        const joined = joinedIds.has(e.id);
        const action = e.mine
          ? '<button class="btn-join" type="button" disabled>Hosting</button>'
          : joined
            ? '<button class="btn-join" type="button" disabled>Joined</button>'
            : `<button class="btn-join" type="button" data-join="${e.id}" aria-label="Join ${e.trail}">Join</button>`;
        return `<article class="card join-card">
          <img class="card-img" src="${e.img}" alt="${e.trail}" width="361" height="230" loading="lazy" />
          <div class="card-body">
            <p class="c-meta">Host - ${e.mine ? 'You' : e.host}</p>
            <h3 class="c-name">${e.trail}</h3>
            <p class="c-small">${e.park} - ${dateShort(e.date)} @ ${time24(e.minutes)}</p>
            <p class="c-small">Activity: ${e.activity}</p>
            ${action}
          </div>
        </article>`;
      })
      .join('');
  }

  function renderSaved() {
    const mine = events.filter((e) => e.mine || joinedIds.has(e.id)).sort((a, b) => a.date.getTime() - b.date.getTime());
    const list = $('#saved-list');
    if (!mine.length) {
      list.innerHTML = `<p class="s-empty">You haven't saved any events yet.<br /><button type="button" data-go-join>Explore events</button> nearby to add one.</p>`;
      return;
    }
    list.innerHTML =
      mine
        .map(
          (e) => `<div class="s-item">
            <img src="${e.img}" alt="" width="47" height="48" />
            <div class="s-text">
              <p class="s-name">${e.trail}</p>
              <p>${dateShort(e.date)} @ ${timeAmPm(e.minutes)}</p>
              <p>${e.mine ? 'Hosted by You' : `Hosted by ${e.host}`}</p>
            </div>
            <span class="s-badge">Upcoming</span>
          </div>`,
        )
        .join('') + `<p class="s-empty"><button type="button" data-go-join>Explore events</button> nearby to add more</p>`;
  }

  // ---------------------------------------------------------------- sheet
  type PanelId = 'when' | 'size' | 'privacy' | 'review' | 'live' | 'join';
  const STEP_OF: Record<string, number> = { when: 1, size: 2, privacy: 3, review: 4 };
  let panel: PanelId = 'when';
  let joinTarget: HostEvent | null = null;

  function setInert(on: boolean) {
    ['.screen', '#topnav', '.bottomnav'].forEach((s) => $$(s).forEach((el) => ((el as HTMLElement & { inert: boolean }).inert = on)));
  }

  function openSheet(id: PanelId, opener?: HTMLElement | null) {
    if (opener !== undefined) openerEl = opener;
    showPanel(id);
    phone.classList.add('sheet-open');
    setInert(true);
    window.setTimeout(() => {
      sheet.focus({ preventScroll: true });
    }, 60);
  }

  function closeSheet() {
    phone.classList.remove('sheet-open');
    setInert(false);
    openerEl?.focus({ preventScroll: true });
  }

  function showPanel(id: PanelId) {
    panel = id;
    $$('.panel', sheet).forEach((p) => (p.hidden = p.dataset.panel !== id));
    const active = $<HTMLElement>(`.panel[data-panel="${id}"]`, sheet);
    sheet.setAttribute('aria-label', $<HTMLElement>('h2', active)?.textContent ?? 'Group hike');
    renderPanel(active, id);
  }

  function bind(root: HTMLElement, values: Record<string, string>) {
    $$('[data-bind]', root).forEach((el) => {
      const key = el.dataset.bind!;
      if (key in values) el.textContent = values[key];
    });
  }

  function renderPanel(root: HTMLElement, id: PanelId) {
    const trail = TRAILS[draft.trailId];
    let activity: Activity = draft.activity;
    let values: Record<string, string> = {};

    if (id === 'join' && joinTarget) {
      activity = joinTarget.activity;
      values = {
        trail: joinTarget.trail,
        time24: time24(joinTarget.minutes),
        dateShort: dateShort(joinTarget.date),
        count: `${joinTarget.joined}/${joinTarget.cap}`,
        activity,
      };
      $$<HTMLImageElement>('[data-bind-img]', root).forEach((i) => { i.src = joinTarget!.img; i.alt = joinTarget!.trail; });
    } else {
      values = {
        trail: trail.name,
        time24: time24(draft.minutes),
        time12: time12(draft.minutes),
        dateShort: dateShort(draft.date),
        dateLong: dateLong(draft.date),
        size: String(draft.size),
        activity,
        reviewTitle: draft.privacy === 'Private' ? 'Review the details' : 'Confirm and post',
        reviewAction: draft.privacy === 'Private' ? 'Next' : 'Post',
        liveHelp:
          draft.privacy === 'Private'
            ? 'This is a private event, meaning people with code or a link can join this event.'
            : 'This is a public event, meaning anyone can join from the community page.',
      };
      $$<HTMLImageElement>('[data-bind-img]', root).forEach((i) => { i.src = trail.img; i.alt = trail.name; });
    }

    bind(root, values);
    root.dataset.activity = activity;

    // step indicator
    const n = STEP_OF[id];
    if (n) {
      $$('.step', root).forEach((s) => {
        const k = Number(s.dataset.n);
        s.classList.toggle('is-current', k === n);
        s.classList.toggle('is-done', k < n);
      });
    }

    if (id === 'when') {
      $<HTMLSelectElement>('#sel-date').value = String(draft.date.getTime());
      $<HTMLSelectElement>('#sel-time').value = String(draft.minutes);
      setSeg(root.querySelector('[data-thumb="activity"]')!, draft.activity === 'Biking', root, '[data-activity]', draft.activity, 'activity');
    }
    if (id === 'size') $<HTMLSelectElement>('#sel-size').value = String(draft.size);
    if (id === 'privacy') setSeg(root.querySelector('[data-thumb="privacy"]')!, draft.privacy === 'Public', root, '[data-privacy]', draft.privacy, 'privacy');
  }

  function setSeg(thumb: Element, right: boolean, root: HTMLElement, optSel: string, value: string, attr: string) {
    thumb.parentElement!.classList.toggle('right', right);
    $$(optSel, root).forEach((o) => o.setAttribute('aria-checked', String(o.dataset[attr] === value)));
  }

  function goNext() {
    if (panel === 'when') showPanel('size');
    else if (panel === 'size') showPanel('privacy');
    else if (panel === 'privacy') showPanel('review');
    else if (panel === 'review') {
      showPanel('live');
    }
  }

  function goBack() {
    if (panel === 'when') closeSheet();
    else if (panel === 'size') showPanel('when');
    else if (panel === 'privacy') showPanel('size');
    else if (panel === 'review') showPanel('privacy');
  }

  // ---------------------------------------------------------------- form options
  function fillSelects() {
    const dates = Array.from({ length: 14 }, (_, i) => addDays(i));
    $<HTMLSelectElement>('#sel-date').innerHTML = dates.map((d) => `<option value="${d.getTime()}">${dateLong(d)}</option>`).join('');
    const times: string[] = [];
    for (let m = 6 * 60; m <= 20 * 60; m += 30) times.push(`<option value="${m}">${time12(m)}</option>`);
    $<HTMLSelectElement>('#sel-time').innerHTML = times.join('');
    $<HTMLSelectElement>('#sel-size').innerHTML = Array.from({ length: 29 }, (_, i) => `<option value="${i + 2}">${i + 2}</option>`).join('');
  }

  // ---------------------------------------------------------------- events
  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const btn = t.closest<HTMLElement>('button');
    if (!btn) return;

    if (btn.dataset.toast) return toast(btn.dataset.toast);
    if (btn.id === 'open-events') { showScreen('events'); showPane('host'); return; }
    if (btn.id === 'back') { showScreen('community'); return; }
    if (btn.dataset.paneTab) return showPane(btn.dataset.paneTab as 'host' | 'join');
    if (btn.dataset.nav) { showScreen(btn.dataset.nav as 'community' | 'saved'); return; }
    if (btn.hasAttribute('data-go-join')) { showScreen('events'); showPane('join'); return; }

    if (btn.dataset.host) {
      draft = newDraft(btn.dataset.host);
      openSheet('when', btn);
      return;
    }
    if (btn.dataset.join) {
      joinTarget = events.find((ev) => ev.id === btn.dataset.join) ?? null;
      if (joinTarget) openSheet('join', btn);
      return;
    }
    if (btn.id === 'confirm-join' && joinTarget) {
      joinTarget.joined += 1;
      joinedIds.add(joinTarget.id);
      closeSheet();
      renderJoin();
      toast('You are in. The event is in Saved.');
      return;
    }
    if (btn.hasAttribute('data-sheet-cancel')) return closeSheet();
    if (btn.hasAttribute('data-step-back')) return goBack();
    if (btn.hasAttribute('data-next')) return goNext();

    if (btn.dataset.activity) { draft.activity = btn.dataset.activity as Activity; renderPanel($('.panel[data-panel="when"]', sheet), 'when'); return; }
    if (btn.dataset.privacy) { draft.privacy = btn.dataset.privacy as Privacy; renderPanel($('.panel[data-panel="privacy"]', sheet), 'privacy'); return; }

    if (btn.id === 'live-done') {
      const t = TRAILS[draft.trailId];
      events = [
        {
          id: `mine-${Date.now()}`,
          trail: t.name,
          host: 'You',
          park: '',
          img: t.img,
          date: draft.date,
          minutes: draft.minutes,
          activity: draft.activity,
          joined: 0,
          cap: draft.size,
          mine: true,
          privacy: draft.privacy,
        },
        ...events,
      ];
      closeSheet();
      toast('Event added to Saved.');
      return;
    }
    if (btn.id === 'copy-code') {
      const label = $('#code-text');
      const done = () => {
        label.textContent = 'Copied';
        window.setTimeout(() => (label.textContent = 'Code: ZXY65'), 1800);
      };
      navigator.clipboard?.writeText('ZXY65').then(done, done);
      return;
    }
    if (btn.id === 'restart') return reset();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && phone.classList.contains('sheet-open')) closeSheet();
  });
  $('#scrim').addEventListener('click', () => closeSheet());

  $<HTMLSelectElement>('#sel-date').addEventListener('change', (e) => {
    draft.date = new Date(Number((e.target as HTMLSelectElement).value));
    bind($('.panel[data-panel="when"]', sheet), { dateLong: dateLong(draft.date) });
  });
  $<HTMLSelectElement>('#sel-time').addEventListener('change', (e) => {
    draft.minutes = Number((e.target as HTMLSelectElement).value);
    bind($('.panel[data-panel="when"]', sheet), { time12: time12(draft.minutes) });
  });
  $<HTMLSelectElement>('#sel-size').addEventListener('change', (e) => {
    draft.size = Number((e.target as HTMLSelectElement).value);
    bind($('.panel[data-panel="size"]', sheet), { size: String(draft.size) });
  });

  // ---------------------------------------------------------------- sizing
  const stage = $('#stage');
  function fit() {
    const s = Math.min(window.innerWidth / 393, (window.innerHeight - 40) / 852, 1.25);
    stage.style.setProperty('--s', String(Math.max(s, 0.3)));
  }
  window.addEventListener('resize', fit);
  fit();

  // ---------------------------------------------------------------- reset + start state
  function reset() {
    closeSheet();
    events = seed();
    joinedIds = new Set();
    draft = newDraft('jug-island');
    showScreen('community');
    showPane('host');
  }

  fillSelects();
  showScreen('community');
  showPane('host');
  showPanel('when');

  // ?start=<state> opens the prototype partway through, for deep links and screenshots.
  const start = new URLSearchParams(location.search).get('start');
  if (start) {
    const events_ = () => { showScreen('events'); showPane('host'); };
    if (start === 'host') events_();
    else if (start === 'join') { showScreen('events'); showPane('join'); }
    else if (start === 'saved') showScreen('saved');
    else if (['when', 'size', 'privacy', 'review', 'live'].includes(start)) {
      events_();
      if (start === 'review' || start === 'live') draft.privacy = 'Public';
      openSheet(start as PanelId, null);
    } else if (start === 'review-private') {
      events_();
      draft.privacy = 'Private';
      openSheet('review', null);
    } else if (start === 'join-sheet') {
      showScreen('events');
      showPane('join');
      joinTarget = events[0];
      openSheet('join', null);
    }
  }
</script>
